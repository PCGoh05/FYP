    "reference": {
      "font_name": "Times New Roman",
      "font_size": 9,
      "bold": false,
      "alignment": "JUSTIFY",
      "line_spacing": 1.15,
      "space_after": 10.0,
      "left_indent": null,
      "hanging_indent": 0.4444444444444444,
      "number_tab_required": true,
      "publication_italic_required": true
    },
    "layout": {
