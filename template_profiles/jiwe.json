{
  "name": "JIWE",
  "description": "Journal of Informatics and Web Engineering manuscript template profile",
  "required_sections": [
    "abstract",
    "keywords",
    "introduction",
    "conclusion",
    "references"
  ],
  "heading_patterns": [
    "introduction",
    "related work",
    "methodology",
    "results",
    "discussion",
    "conclusion",
    "references"
  ],
  "classification_patterns": {
    "journal_header": [
      "journal\\s+of\\s+informatics",
      "web\\s+engineering$",
      "vol\\.\\s*\\d+",
      "eissn|pissn|issn"
    ],
    "caption": [
      "^(figure|fig\\.?|table)\\s*\\d+"
    ],
    "reference": [
      "^\\[\\d+\\]"
    ],
    "author_info": [
      "orcid",
      "corresponding\\s+author",
      "university|universiti|faculty|fakulti|department|school|college|institute"
    ]
  },
  "rule_weights": {
    "margins": 10,
    "title": 15,
    "body_text": 20,
    "headings": 10,
    "structure": 15,
    "tables": 5,
    "figures": 5,
    "references": 10,
    "line_spacing": 5,
    "other": 5
  },
  "fallback_defaults": {
    "font_name": "Times New Roman",
    "body_font_size": 10,
    "abstract_font_size": 9,
    "caption_font_size": 10,
    "reference_font_size": 9,
    "page_size": "Letter"
  },
  "rules": {
    "margins": {
      "left": 1.0,
      "right": 1.0,
      "top": 1.0,
      "bottom": 1.0
    },
    "journal_header": {
      "font_name": "Palatino Linotype",
      "font_size": 24,
      "bold": true,
      "alignment": "CENTER"
    },
    "title": {
      "font_name": "Times New Roman",
      "font_size": 24,
      "bold": null,
      "italic": false,
      "alignment": "CENTER"
    },
    "author": {
      "font_name": "Times New Roman",
      "font_size": 11,
      "bold": true,
      "alignment": "CENTER"
    },
    "affiliation": {
      "font_name": "Times New Roman",
      "font_size": 9,
      "alignment": "CENTER"
    },
    "body": {
      "font_name": "Times New Roman",
      "font_size": 10,
      "line_spacing": 1.0
    },
    "heading": {
      "font_name": "Times New Roman",
      "font_size": 10,
      "bold": true,
      "all_caps": true
    },
    "abstract": {
      "font_name": "Times New Roman",
      "font_size": 9
    },
    "keywords": {
      "font_name": "Times New Roman",
      "font_size": 9
    },
    "caption": {
      "font_name": "Times New Roman",
      "font_size": 10,
      "italic": false
    },
    "reference": {
      "font_name": "Times New Roman",
      "font_size": 9
    },
    "layout": {
      "columns": 1,
      "page_size": "Letter"
    }
  }
}
