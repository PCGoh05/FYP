{
  "name": "JIWE",
  "description": "Journal of Informatics and Web Engineering manuscript template profile",
  "required_sections": [
    "abstract",
    "keywords",
    "introduction",
    "conclusion",
    "references"
  ],
  "heading_patterns": [
    "introduction",
    "related work",
    "methodology",
    "results",
    "discussion",
    "conclusion",
    "references"
  ],
  "required_declarations": [
    "funding_statement",
    "author_contributions",
    "conflict_of_interests",
    "data_availability"
  ],
  "classification_patterns": {
    "journal_header": [
      "journal\\s+of\\s+informatics",
      "web\\s+engineering$",
      "vol\\.\\s*\\d+",
      "eissn|pissn|issn"
    ],
    "caption": [
      "^(figure|fig\\.?|table)\\s*\\d+"
    ],
    "reference": [
      "^\\[\\d+\\]"
    ],
    "author_info": [
      "orcid",
      "corresponding\\s+author",
      "university|universiti|faculty|fakulti|department|school|college|institute"
    ]
  },
  "rule_weights": {
    "margins": 10,
    "title": 15,
    "body_text": 20,
    "headings": 10,
    "structure": 15,
    "tables": 5,
    "figures": 5,
    "references": 10,
    "line_spacing": 5,
    "other": 5
  },
  "fallback_defaults": {
    "font_name": "Times New Roman",
    "body_font_size": 10,
    "abstract_font_size": 9,
    "caption_font_size": 10,
    "reference_font_size": 9,
    "page_size": "Letter"
  },
  "rules": {
    "author_role_terms": {
      "affiliation": [
        "address",
        "academy",
        "bhd",
        "campus",
        "centre",
        "center",
        "clinical informatics unit",
        "company",
        "corporation",
        "department",
        "faculty",
        "gmbh",
        "hospital",
        "inc",
        "institute",
        "jalan",
        "laboratory",
        "limited",
        "llc",
        "ltd",
        "medical centre",
        "medical center",
        "pte ltd",
        "research centre",
        "research center",
        "school",
        "sdn bhd",
        "street",
        "systems",
        "technologies",
        "university",
        "universiti"
      ]
    },
    "margins": {
      "left": 1.0,
      "right": 1.0,
      "top": 1.0,
      "bottom": 1.0
    },
    "journal_header": {
      "font_name": "Palatino Linotype",
      "font_size": 24,
      "bold": true,
      "alignment": "CENTER"
    },
    "title": {
      "font_name": "Times New Roman",
      "font_size": 24,
      "bold": null,
      "italic": false,
      "alignment": "CENTER"
    },
    "author": {
      "font_name": "Times New Roman",
      "font_size": 11,
      "bold": true,
      "alignment": "CENTER"
    },
    "affiliation": {
      "font_name": "Times New Roman",
      "font_size": 9,
      "alignment": "CENTER"
    },
    "corresponding_author": {
      "font_name": "Times New Roman",
      "font_size": 9,
      "bold": false,
      "italic": true,
      "alignment": "CENTER",
      "email_required": true,
      "orcid_required": true
    },
    "body": {
      "font_name": "Times New Roman",
      "font_size": 10,
      "bold": false,
      "line_spacing": 1.0,
      "alignment": "JUSTIFY"
    },
    "heading": {
      "font_name": "Times New Roman",
      "font_size": 10,
      "bold": true,
      "all_caps": true
    },
    "subheading": {
      "font_name": "Times New Roman",
      "font_size": 10,
      "bold": false,
      "italic": true
    },
    "abstract": {
      "font_name": "Times New Roman",
      "font_size": 9,
      "bold": false,
      "alignment": "JUSTIFY",
      "min_words": 200,
      "max_words": 300,
      "one_paragraph": true,
      "prohibit_equations": true,
      "prohibit_tables": true,
      "prohibit_citations": true
    },
    "keywords": {
      "font_name": "Times New Roman",
      "font_size": 9,
      "bold": false,
      "italic": true,
      "min_count": 5,
      "capitalize_first_letter": true
    },
    "caption": {
      "font_name": "Times New Roman",
      "font_size": 10,
      "italic": false
    },
    "reference": {
      "font_name": "Times New Roman",
      "font_size": 9,
      "bold": false,
      "alignment": "JUSTIFY",
      "line_spacing": 1.15,
      "publication_italic_required": true
    },
    "layout": {
      "columns": 1,
      "page_size": "Letter",
      "orientation": "PORTRAIT"
    }
  }
}
