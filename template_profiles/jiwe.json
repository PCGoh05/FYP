{
  "name": "JIWE",
  "description": "Journal of Informatics and Web Engineering manuscript template profile",
  "required_sections": [
    "abstract",
    "keywords",
    "introduction",
    "conclusion",
    "references"
  ],
  "heading_patterns": [
    "introduction",
    "related work",
    "methodology",
    "results",
    "discussion",
    "conclusion",
    "references"
  ],
  "required_declarations": [
    "acknowledgement",
    "funding_statement",
    "author_contributions",
    "conflict_of_interests",
    "ethics_statements",
    "data_availability"
  ],
  "declaration_templates": {
    "acknowledgement": {
      "heading": "ACKNOWLEDGEMENT",
      "paragraphs": [
        "The authors would like to thank the anonymous reviewers for the suggestions to improve the paper."
      ]
    },
    "funding_statement": {
      "heading": "FUNDING STATEMENT",
      "paragraphs": [
        "The authors received no funding from any party for the research and publication of this article."
      ]
    },
    "author_contributions": {
      "heading": "AUTHOR CONTRIBUTIONS",
      "paragraphs": [
        "AAA: Conceptualization, Data Curation, Methodology, Validation, Writing - Original Draft Preparation;",
        "BBB: Project Administration, Writing - Review & Editing;",
        "CCC: Project Administration, Supervision, Writing - Review & Editing."
      ]
    },
    "conflict_of_interests": {
      "heading": "CONFLICT OF INTERESTS",
      "paragraphs": [
        "No conflict of interests were disclosed."
      ]
    },
    "ethics_statements": {
      "heading": "ETHICS STATEMENTS",
      "paragraphs": [
        "Our publication ethics follow The Committee of Publication Ethics (COPE) guideline. https://publicationethics.org/",
        "If your work involved human subjects, please include a statement here confirming that the relevant informed consent was obtained from those subjects:",
        "If your work involved animal experiments, please include a statement here of the ethics permission or animal licenses. If animals were used but ethical approval was not required, a clear statement should be included stating why this approval was unnecessary.",
        "If your work involved data collected from social media platforms, please include a statement here confirming that informed consent was obtained from participants or that participant data has been fully anonymized, and that the platform data redistribution policies were complied with."
      ]
    },
    "data_availability": {
      "heading": "DATA AVAILABILITY",
      "paragraphs": [
        "Data availability is not applicable to this paper as no new data were created or analyzed in this study."
      ]
    }
  },
  "classification_patterns": {
    "journal_header": [
      "journal\\s+of\\s+informatics",
      "web\\s+engineering$",
      "vol\\.\\s*\\d+",
      "eissn|pissn|issn"
    ],
    "caption": [
      "^(figure|fig\\.?|table)\\s*\\d+"
    ],
    "reference": [
      "^\\[\\d+\\]"
    ],
    "author_info": [
      "orcid",
      "corresponding\\s+author",
      "university|universiti|faculty|fakulti|department|school|college|institute"
    ]
  },
  "rule_weights": {
    "margins": 10,
    "title": 15,
    "body_text": 20,
    "headings": 10,
    "structure": 15,
    "tables": 5,
    "figures": 5,
    "references": 10,
    "line_spacing": 5,
    "other": 5
  },
  "fallback_defaults": {
    "font_name": "Times New Roman",
    "body_font_size": 10,
    "abstract_font_size": 9,
    "caption_font_size": 10,
    "reference_font_size": 9,
    "page_size": "Letter"
  },
  "rules": {
    "author_role_terms": {
      "affiliation": [
        "address",
        "academy",
        "bhd",
        "campus",
