      "max_words": 300,
      "one_paragraph": true,
      "prohibit_equations": true,
      "prohibit_tables": true,
      "prohibit_citations": true
    },
    "keywords": {
      "font_name": "Times New Roman",
      "font_size": 9,
      "bold": false,
